#!/bin/sh

# Aggregates the pilot's per-attempt artifacts into the final table.
#
# It refuses to average what must not be averaged. A row is only counted when its
# routing matched the arm and every judgement field was filled in by the judge and
# the blind reviewer. Anything else is reported in the excluded table with its
# cause, because a pilot that hides its failures inside a mean is worse than no
# pilot.

set -eu

attempts=${1-}
[ -n "$attempts" ] && [ -d "$attempts" ] || {
  printf '%s\n' 'usage: pilot-report ATTEMPTS_DIR' >&2
  exit 1
}

value() {
  awk -v k="$2" '
    match($0, "\"" k "\":[ ]*\"[^\"]*\"") {
      s = substr($0, RSTART, RLENGTH)
      sub("\"" k "\":[ ]*\"", "", s)
      sub("\"$", "", s)
      print s; exit
    }
    match($0, "\"" k "\":[ ]*[0-9.]+") {
      s = substr($0, RSTART, RLENGTH)
      sub("\"" k "\":[ ]*", "", s)
      print s; exit
    }
  ' "$1"
}

valid_decimal() {
  awk -v n="$1" 'BEGIN { exit !(n ~ /^[0-9]+([.][0-9]+)?$/) }'
}

sum_costs() {
  cost_kind=$1
  sum=0
  for cost_file in "$attempts/${task}__${arm}__${cost_kind}__"*.json; do
    [ -f "$cost_file" ] || continue
    amount=$(value "$cost_file" cost_usd)
    valid_decimal "$amount" || return 1
    sum=$(awk -v a="$sum" -v b="$amount" 'BEGIN { printf "%.4f", a + b }')
  done
  printf '%.4f\n' "$sum"
}

sum_linked_costs() {
  cost_kind=$1; expected_id=$2
  found=no; sum=0
  for cost_file in "$attempts/${task}__${arm}__${cost_kind}__"*.json; do
    [ -f "$cost_file" ] || continue
    found=yes
    amount=$(value "$cost_file" cost_usd)
    valid_decimal "$amount" || return 2
    [ "$(value "$cost_file" child_thread_id)" = "$expected_id" ] || return 3
    [ "$(value "$cost_file" routing_ok)" = yes ] || return 4
    sum=$(awk -v a="$sum" -v b="$amount" 'BEGIN { printf "%.4f", a + b }')
  done
  [ "$found" = yes ] || return 1
  printf '%.4f\n' "$sum"
}

printf 'tarea\tbase_sha\tbloque\tbrazo\tagent_type\torden\tprompt_sha256\tmodelo\teffort\trouting_ok\taceptado\tblocking\timportant\tcorrecciones\tcached\tuncached\toutput\treasoning\treloj_s\tcoste_impl\tcoste_review\tcoste_correcciones\tcoste_total\tfallo\n'

excluded=$(mktemp "${TMPDIR:-/tmp}/pilot-excluded.XXXXXX")
trap 'rm -f "$excluded"' EXIT HUP INT TERM

for f in "$attempts"/*__implementation__*.json; do
  [ -f "$f" ] || continue
  task=$(value "$f" task); arm=$(value "$f" arm)
  routing=$(value "$f" routing_ok); accepted=$(value "$f" accepted)

  cause=
  case $routing in
    yes) ;;
    KILLED) cause=cap ;;
    NO-DISPATCH) cause=infraestructura ;;
    *) cause=routing ;;
  esac
  if [ -z "$cause" ]; then
    case $accepted in
      '') cause=missing-accepted ;;
      yes|no) ;;
      *) cause=invalid-accepted ;;
    esac
  fi
  if [ -z "$cause" ]; then
    for judgement in blocking important corrections; do
      judgement_value=$(value "$f" "$judgement")
      case $judgement_value in
        '') cause=missing-$judgement; break ;;
        *[!0-9]*) cause=invalid-$judgement; break ;;
      esac
    done
  fi
  if [ -z "$cause" ]; then
    reviewer_id=$(value "$f" reviewer_id)
    adjudicator_id=$(value "$f" adjudicator_id)
    [ -n "$reviewer_id" ] || cause=missing-reviewer_id
    [ -n "$cause" ] || [ "$reviewer_id" != - ] || cause=invalid-reviewer_id
    [ -n "$cause" ] || [ -n "$adjudicator_id" ] || cause=missing-adjudicator_id
  fi
  if [ -z "$cause" ]; then
    for identity in task block arm agent_type base_sha prompt_sha256 parent_thread_id \
      child_thread_id model effort; do
      identity_value=$(value "$f" "$identity")
      case $identity_value in ''|-) cause=invalid-$identity; break ;; esac
    done
  fi

  cost_impl=$(value "$f" cost_usd)
  [ -n "$cause" ] || valid_decimal "$cost_impl" || cause=invalid-cost_usd
  if [ -z "$cause" ]; then
    if ! cost_corr=$(sum_costs correction); then cause=invalid-correction-cost; fi
  fi
  if [ -z "$cause" ]; then
    review_status=0
    cost_rev=$(sum_linked_costs review "$reviewer_id") || review_status=$?
    case $review_status in
      0) ;;
      1) cause=missing-review-artifact ;;
      2) cause=invalid-review-cost ;;
      3) cause=unlinked-reviewer_id ;;
      4) cause=invalid-review-routing ;;
    esac
  fi
  if [ -z "$cause" ] && [ "$adjudicator_id" != - ]; then
    adjudication_status=0
    cost_adjudication=$(sum_linked_costs adjudication "$adjudicator_id") \
      || adjudication_status=$?
    case $adjudication_status in
      0) cost_rev=$(awk -v a="$cost_rev" -v b="$cost_adjudication" \
           'BEGIN { printf "%.4f", a + b }') ;;
      1) cause=missing-adjudication-artifact ;;
      2) cause=invalid-adjudication-cost ;;
      3) cause=unlinked-adjudicator_id ;;
      4) cause=invalid-adjudication-routing ;;
    esac
  fi

  if [ -n "$cause" ]; then
    printf '%s\t%s\t%s\t%s\n' "$task" "$arm" "$routing" "$cause" >> "$excluded"
    continue
  fi

  # Cost to accepted is the candidate's own: implementation, its corrections and
  # the reviewers that judged it. Spec review and lead orchestration are shared
  # overhead and are reported separately, never folded into an arm.
  total=$(awk -v a="$cost_impl" -v b="$cost_corr" -v c="$cost_rev" 'BEGIN { printf "%.4f", a + b + c }')

  printf '%s\t' "$task" "$(value "$f" base_sha)" "$(value "$f" block)" "$arm" \
    "$(value "$f" agent_type)" "$(value "$f" order)" "$(value "$f" prompt_sha256)" \
    "$(value "$f" model)" "$(value "$f" effort)" "$routing" "$accepted" \
    "$(value "$f" blocking)" "$(value "$f" important)" "$(value "$f" corrections)" \
    "$(value "$f" tokens_cached)" "$(value "$f" tokens_uncached)" "$(value "$f" tokens_output)" \
    "$(value "$f" tokens_reasoning)" "$(value "$f" wall_seconds)" \
    "$cost_impl" "$cost_rev" "$cost_corr" "$total"
  printf '%s\n' "$(value "$f" failure_detail)"
done

if [ -s "$excluded" ]; then
  printf '\n# intentos excluidos\ntarea\tbrazo\trouting\tcausa\n'
  cat "$excluded"
fi

printf '\n# overhead compartido (spec review y orquestacion del lead)\n'
shared=$(cat "$attempts"/*__spec-review__*.json "$attempts"/*__orchestration__*.json 2>/dev/null |
  grep -h 'cost_usd' |
  awk 'match($0, /"cost_usd":[0-9.]+/) { sum += substr($0, RSTART + 11, RLENGTH - 11) } END { printf "%.4f", sum + 0 }')
printf 'coste_overhead_usd\t%s\n' "$shared"

printf '\n# gasto total registrado (todos los artefactos)\n'
cat "$attempts"/*.json 2>/dev/null |
  awk 'match($0, /"cost_usd":[0-9.]+/) { sum += substr($0, RSTART + 11, RLENGTH - 11) } END { printf "coste_total_usd\t%.4f\n", sum + 0 }'
