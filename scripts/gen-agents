#!/bin/sh

# Materialize the canonical roles in agents/roles/ as host-specific subagent
# definitions. The role files are the single source of truth; this script only
# resolves each role's aliases through a model map and renders them per host.
#
# There are still exactly FOUR canonical roles. This generator emits one file per
# (role, state) pair — base and escalated — from those same four definitions. A
# generated file is a materialized state, not a new role: nothing here creates a
# fifth role, and the generic-role rule of the contract is unchanged.
#
# The states must be separate files because the host resolves routing from the
# named agent: when `agent_type` names a custom agent, the definition's model and
# effort win over any override passed at spawn time. Escalation therefore has to
# be a different `agent_type`, never an override.

set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
GEN_ROOT=${GEN_ROOT:-$(CDPATH= cd -- "$script_dir/.." && pwd -P)}
roles_dir=$GEN_ROOT/agents/roles
example_map=$GEN_ROOT/settings/schemas/model-map.example.yaml

usage() {
  cat >&2 <<'EOF'
usage:
  gen-agents --host <codex|claude> --out DIR   [--model-map PATH] [--require-local-map]
  gen-agents --host <codex|claude> --role NAME [--model-map PATH] [--require-local-map]
  gen-agents --host <codex|claude> --list
  gen-agents --resolve --host <codex|claude> [--model-map PATH]
  gen-agents --map-path  [--model-map PATH]
EOF
}

stop() {
  printf '%s\n' "STOP $*" >&2
  exit 1
}

host=
out=
role=
map=
action=
require_local=false

while [ "$#" -gt 0 ]; do
  case $1 in
    --host)
      shift; [ "$#" -gt 0 ] || { usage; exit 1; }
      host=$1
      ;;
    --out)
      shift; [ "$#" -gt 0 ] || { usage; exit 1; }
      out=$1; action=${action:-render_all}
      ;;
    --role)
      shift; [ "$#" -gt 0 ] || { usage; exit 1; }
      role=$1; action=${action:-render_one}
      ;;
    --model-map)
      shift; [ "$#" -gt 0 ] || { usage; exit 1; }
      map=$1
      ;;
    --list) action=list ;;
    --resolve) action=resolve ;;
    --map-path) action=map_path ;;
    --require-local-map) require_local=true ;;
    *) usage; exit 1 ;;
  esac
  shift
done

[ -n "$action" ] || { usage; exit 1; }
[ -d "$roles_dir" ] || stop "missing roles directory $roles_dir"

scaffolding_states_tmp=$(mktemp "${TMPDIR:-/tmp}/gen-agents-states.XXXXXX")
trap 'rm -f "$scaffolding_states_tmp"' EXIT HUP INT TERM

case $action in
  render_all|render_one|list|resolve)
    case $host in
      codex|claude) ;;
      '') stop '--host is required' ;;
      *) stop "unsupported host $host; only codex and claude expose subagent files" ;;
    esac
    ;;
esac

resolve_map() {
  if [ -n "$map" ]; then
    [ -f "$map" ] || stop "model map not found: $map"
    printf '%s\n' "$map"
    return 0
  fi
  if [ -n "${XDG_CONFIG_HOME-}" ] && [ -f "$XDG_CONFIG_HOME/agent-scaffolding/model-map.yaml" ]; then
    printf '%s\n' "$XDG_CONFIG_HOME/agent-scaffolding/model-map.yaml"
    return 0
  fi
  if [ -n "${HOME-}" ] && [ -f "$HOME/.config/agent-scaffolding/model-map.yaml" ]; then
    printf '%s\n' "$HOME/.config/agent-scaffolding/model-map.yaml"
    return 0
  fi
  printf '%s\n' "$example_map"
}

map_file=$(resolve_map)
[ -f "$map_file" ] || stop "model map not found: $map_file"
if [ "$map_file" = "$example_map" ]; then
  if [ "$require_local" = true ]; then
    stop 'only the example model map is available; it holds code names, not model ids. Copy settings/schemas/model-map.example.yaml to ~/.config/agent-scaffolding/model-map.yaml and set real model ids.'
  fi
fi

map_lookup() {
  awk -v want="$1" -v field="$2" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    /^  - id:[[:space:]]*/ {
      value = $0
      sub(/^  - id:[[:space:]]*/, "", value)
      gsub(/"/, "", value)
      current = (value == want)
      next
    }
    current && $0 ~ ("^    " field ":[[:space:]]*") {
      value = $0
      sub(/^    [a-z_]+:[[:space:]]*/, "", value)
      gsub(/"/, "", value)
      print value
      exit
    }
  ' "$map_file"
}

# Model ids are not portable across hosts, so the map resolves an alias per host.
# A missing entry stops: writing another host's id into a definition is exactly
# the failure this indirection exists to prevent.
alias_model() {
  value=$(map_lookup "$1" "model_$host")
  if [ -z "$value" ]; then
    stop "alias $1 has no model_$host in $map_file; each host needs its own model id"
  fi
  printf '%s\n' "$value"
}

alias_effort() {
  value=$(map_lookup "$1" effort)
  [ -n "$value" ] || stop "alias $1 has no effort in $map_file"
  printf '%s\n' "$value"
}

role_field() {
  awk -v key="$2" '
    NR == 1 && $0 == "---" { inside = 1; next }
    inside && $0 == "---" { exit }
    inside {
      k = $0
      sub(/:.*/, "", k)
      if (k == key) {
        value = $0
        sub(/^[a-z_]+:[[:space:]]*/, "", value)
        sub(/^"/, "", value)
        sub(/"$/, "", value)
        print value
        exit
      }
    }
  ' "$1"
}

role_body() {
  awk '
    NR == 1 && $0 == "---" { frontmatter = 1; next }
    frontmatter && $0 == "---" { frontmatter = 0; next }
    !frontmatter { print }
  ' "$1"
}

return_contract() {
  awk '
    /^## Envelope de retorno$/ { section = 1; next }
    section && /^## / { exit }
    section { print }
  ' "$GEN_ROOT/agents/README.md"
}

toml_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

role_files() {
  for candidate in "$roles_dir"/*.md; do
    [ -f "$candidate" ] || continue
    printf '%s\n' "$candidate"
  done
}

host_filename() {
  case $host in
    codex) printf '%s.toml\n' "$1" ;;
    claude) printf '%s.md\n' "$1" ;;
  esac
}

# Emits `state|name|alias|effort` for every state of one role. A role whose two
# states share an alias is disambiguated by effort, so the two files never
# collapse into one name.
role_states() {
  role_file=$1
  base_name=$(role_field "$role_file" name)
  base_alias=$(role_field "$role_file" alias)
  base_effort=$(role_field "$role_file" effort)
  escalated_alias=$(role_field "$role_file" escalated_alias)
  escalated_effort=$(role_field "$role_file" escalated_effort)
  additional=$(role_field "$role_file" additional_states)
  [ -n "$base_name" ] || stop "role ${role_file##*/} is missing name"

  # kind|alias|effort for every state this role can run at. `additional_states`
  # holds rungs that are neither the base nor the escalated one, such as the
  # cheap tier the contract assigns to fully specified mechanical work.
  {
    printf 'base|%s|%s\n' "$base_alias" "$base_effort"
    printf 'escalated|%s|%s\n' "$escalated_alias" "$escalated_effort"
    if [ -n "$additional" ]; then
      printf '%s\n' "$additional" | tr ',' '\n' | while read -r pair; do
        pair=$(printf '%s' "$pair" | tr -d ' ')
        [ -n "$pair" ] || continue
        case $pair in
          *:*) printf 'additional|%s|%s\n' "${pair%%:*}" "${pair#*:}" ;;
          *) stop "role ${role_file##*/} has a malformed additional_states entry: $pair" ;;
        esac
      done
    fi
  } > "$scaffolding_states_tmp"

  # An alias used by more than one state is disambiguated by effort, so two
  # states never collapse onto one name.
  while IFS='|' read -r kind alias effort; do
    [ -n "$alias" ] || continue
    if [ "$(awk -F'|' -v a="$alias" '$2 == a' "$scaffolding_states_tmp" | grep -c .)" -gt 1 ]; then
      printf '%s|%s|%s|%s\n' "$kind" "$base_name-$alias-$effort" "$alias" "$effort"
    else
      printf '%s|%s|%s|%s\n' "$kind" "$base_name-$alias" "$alias" "$effort"
    fi
  done < "$scaffolding_states_tmp"

  # A role that deliberately overrides a host built-in also keeps its bare name,
  # pinned to the base state. Without it the built-in would come back and resolve
  # at the host default, which is a silent routing loss.
  if [ "$(role_field "$role_file" overrides_builtin)" = true ]; then
    printf 'base|%s|%s|%s\n' "$base_name" "$base_alias" "$base_effort"
  fi
}

load_role() {
  role_file=$1
  state=$2
  state_name=$3
  state_alias=$4
  state_effort=$5

  role_of=$(role_field "$role_file" name)
  role_description=$(role_field "$role_file" description)
  role_alias=$(role_field "$role_file" alias)
  role_effort=$(role_field "$role_file" effort)
  role_escalated_alias=$(role_field "$role_file" escalated_alias)
  role_escalated_effort=$(role_field "$role_file" escalated_effort)
  role_trigger=$(role_field "$role_file" escalation_trigger)
  role_authority=$(role_field "$role_file" authority)

  for required in role_of role_description role_alias role_effort \
    role_escalated_alias role_escalated_effort role_trigger role_authority; do
    eval "value=\$$required"
    [ -n "$value" ] || stop "role ${role_file##*/} is missing ${required#role_}"
  done

  role_name=$state_name
  role_model=$(alias_model "$state_alias")
  role_state_alias=$state_alias
  role_state_effort=$state_effort
  role_state=$state

  # The name of the sibling state, which is how escalation is actually dispatched.
  # Drain the producer even after the first match; early exit causes SIGPIPE
  # when role_states still has sibling states to emit.
  role_escalated_name=$(role_states "$role_file" | awk -F'|' '$1 == "escalated" && !found { print $2; found = 1 }')
  role_base_name=$(role_states "$role_file" | awk -F'|' '$1 == "base" && !found { print $2; found = 1 }')
  role_escalated_model=$(alias_model "$role_escalated_alias")

  case $role_authority in
    read-only|write) ;;
    *) stop "role ${role_file##*/} has unsupported authority $role_authority" ;;
  esac
  role_body_text=$(role_body "$role_file") || stop "cannot read role body: $role_file"
  [ -n "$role_body_text" ] || stop "empty role body: $role_file"
}

role_instructions() {
  printf '%s\n' "Act as the \`$role_of\` role of the agent-scaffolding contract, for the bounded"
  printf '%s\n' 'task the lead assigns. The role and shared return contract are included below;'
  printf '%s\n' 'follow them and the launch brief without looking them up in the project cwd.'
  printf '%s\n' "This file is one materialized state of that role, not a role of its own: the"
  printf '%s\n' "contract has exactly four generic roles."
  printf '\n'
  if [ "$role_authority" = read-only ]; then
    printf '%s\n' 'Authority: read-only. Do not write files, run mutating commands, publish to Git,'
    printf '%s\n' 'delegate further, or expand scope. Report; do not decide.'
  else
    printf '%s\n' 'Authority: write, restricted to the paths the brief assigns. Do not touch shared'
    printf '%s\n' 'contracts, schemas, lockfiles, generated files or snapshots unless the brief'
    printf '%s\n' 'assigns them to you, and never delegate further.'
  fi
  printf '\n'
  printf '%s\n' "Routing: this state is the \`$role_state_alias\` alias ($role_model, reasoning effort $role_state_effort)."
  if [ "$role_state" = additional ]; then
    printf '%s\n' "This is a lower rung of \`$role_of\`, for work the brief specifies completely."
    printf '%s\n' "The role's default state is \`$role_base_name\`; its escalated state is \`$role_escalated_name\`."
    printf '%s\n' 'Move up by dispatching that name. Never by overriding model or effort: this'
    printf '%s\n' 'definition wins over any such override, so the dispatch would silently run here.'
  elif [ "$role_state" = base ]; then
    printf '%s\n' "Escalation: the lead escalates by dispatching \`$role_escalated_name\` when"
    printf '%s\n' "$role_trigger."
    printf '%s\n' 'Escalation is dispatched by name. Never escalate by passing a model or effort'
    printf '%s\n' 'override at spawn time: this definition wins over any such override, so the'
    printf '%s\n' 'dispatch would silently run at this state instead of the escalated one.'
  else
    printf '%s\n' "This is the escalated state of \`$role_of\`; its base state is \`$role_base_name\`."
    printf '%s\n' 'It is reached by dispatching this name, never by overriding model or effort.'
  fi
  printf '%s\n' 'Never change your own model or effort, and never silently continue past that line.'
  printf '\n'
  printf '%s\n' "$role_body_text"
  printf '\n'
  printf '%s\n' '## Shared return contract'
  printf '%s\n' "$shared_return_contract"
  printf '\n'
  printf '%s\n' 'STOP and return `blocked` with evidence when the base SHA, ownership, contract or'
  printf '%s\n' 'required evidence is missing, when scope would grow, or when your budget is spent.'
}

state_description() {
  case $role_state in
    base)
      printf '%s (state: %s, %s)' "$role_description" "$role_state_alias" "$role_state_effort"
      ;;
    additional)
      printf 'Lower rung of the %s role, for fully specified work. %s (state: %s, %s)' \
        "$role_of" "$role_description" "$role_state_alias" "$role_state_effort"
      ;;
    *)
      printf 'Escalated state of the %s role. %s (state: %s, %s)' \
        "$role_of" "$role_description" "$role_state_alias" "$role_state_effort"
      ;;
  esac
}

render_codex() {
  printf '%s\n' "# Generated by scripts/gen-agents from agents/roles/$role_of.md. Do not edit by hand."
  printf 'name = "%s"\n' "$(toml_escape "$role_name")"
  printf 'description = "%s"\n' "$(toml_escape "$(state_description)")"
  printf 'model = "%s"\n' "$(toml_escape "$role_model")"
  printf 'model_reasoning_effort = "%s"\n' "$(toml_escape "$role_state_effort")"
  printf 'developer_instructions = """\n'
  role_instructions | sed 's/\\/\\\\/g; s/"""/\\"\\"\\"/g'
  printf '"""\n'
}

render_claude() {
  printf '%s\n' '---'
  printf 'name: %s\n' "$role_name"
  printf 'description: %s\n' "$(state_description)"
  printf 'model: %s\n' "$role_model"
  if [ "$role_authority" = read-only ]; then
    printf 'tools: Read, Grep, Glob\n'
  fi
  printf '%s\n' '---'
  printf '\n'
  printf '%s\n' "<!-- Generated by scripts/gen-agents from agents/roles/$role_of.md. Do not edit by hand. -->"
  printf '\n'
  role_instructions
}

render_role() {
  load_role "$1" "$2" "$3" "$4" "$5"
  case $host in
    codex) render_codex ;;
    claude) render_claude ;;
  esac
}

# Validate source instructions before the Codex encoder pipeline can mask a
# failed read. List/resolve do not need prompt content.
case $action in
  render_all|render_one)
    shared_return_contract=$(return_contract) || stop 'cannot read shared return contract'
    [ -n "$shared_return_contract" ] || stop 'empty shared return contract'
    ;;
esac

case $action in
  map_path)
    printf '%s\n' "$map_file"
    ;;
  resolve)
    for id in economy balanced frontier critical diagnostic; do
      model=$(map_lookup "$id" "model_$host")
      effort=$(map_lookup "$id" effort)
      [ -n "$model" ] || continue
      printf '%s|%s|%s\n' "$id" "$model" "$effort"
    done
    ;;
  list)
    role_files | while read -r role_file; do
      role_states "$role_file" | while IFS='|' read -r state name alias effort; do
        [ -n "$name" ] || continue
        printf '%s|%s|%s\n' "$name" "$(host_filename "$name")" "$role_file"
      done
    done
    ;;
  render_one)
    found=false
    for role_file in $(role_files); do
      match=$(role_states "$role_file" | awk -F'|' -v want="$role" '$2 == want && !found { print; found = 1 }')
      [ -n "$match" ] || continue
      found=true
      old_ifs=$IFS; IFS='|'; set -- $match; IFS=$old_ifs
      render_role "$role_file" "$1" "$2" "$3" "$4"
      break
    done
    [ "$found" = true ] || stop "unknown role state $role"
    ;;
  render_all)
    [ -d "$out" ] || stop "output directory does not exist: $out"
    for role_file in $(role_files); do
      role_states "$role_file" > "$out/.states.$$"
      while IFS='|' read -r state name alias effort; do
        [ -n "$name" ] || continue
        render_role "$role_file" "$state" "$name" "$alias" "$effort" > "$out/$(host_filename "$name")"
        printf '%s\n' "WROTE $out/$(host_filename "$name")"
      done < "$out/.states.$$"
      rm -f "$out/.states.$$"
    done
    ;;
esac
